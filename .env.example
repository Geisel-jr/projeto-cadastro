# Variáveis usadas pelo docker-compose (copie para ".env" se quiser trocar os valores padrão)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cadastros_db
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# Autenticação
JWT_SECRET=troque-por-um-valor-aleatorio-longo   # ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Primeiro usuário (só na primeira subida, com o banco vazio):
#   vazio = conta de demonstração demo@cadastrohub.local / Demo@2026, mostrada na tela de login
#   preenchido = administrador com senha provisória (use um e-mail real: ele recebe o código de acesso)
ADMIN_EMAIL=
ADMIN_PASSWORD=                                    # senha provisória; vazio = gerada e mostrada no log da API
DADOS_EXEMPLO=true                                 # empresas, pessoas e documentos de exemplo na primeira subida
GOOGLE_CLIENT_ID=                                  # Client ID OAuth do Google; vazio = login com Google desligado
COOKIE_SECURE=false                                # true em produção (HTTPS)
MFA_ADMIN=true                                     # administradores confirmam o login com um código enviado por e-mail

# Backup automático (docker compose)
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCAO_DIAS=7
FUSO_HORARIO=America/Sao_Paulo   # ex: America/Manaus, America/Cuiaba

# E-mail (recuperação de senha e código de acesso). Vazio = Mailpit local do docker compose (http://localhost:8025)
APP_URL=http://localhost:3000      # endereço público do sistema, usado nos links dos e-mails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=CadastroHub <nao-responda@cadastrohub.local>
