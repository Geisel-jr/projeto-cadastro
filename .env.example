# Variáveis usadas pelo docker-compose (copie para ".env" se quiser trocar os valores padrão)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cadastros_db
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# Autenticação
JWT_SECRET=troque-por-um-valor-aleatorio-longo   # ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=admin@cadastrohub.local                # primeiro administrador (criado se não houver usuários)
ADMIN_PASSWORD=                                    # senha provisória; vazio = gerada e mostrada no log da API
GOOGLE_CLIENT_ID=                                  # Client ID OAuth do Google; vazio = login com Google desligado
COOKIE_SECURE=false                                # true em produção (HTTPS)

# Backup automático (docker compose)
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCAO_DIAS=7
FUSO_HORARIO=America/Sao_Paulo   # ex: America/Manaus, America/Cuiaba
