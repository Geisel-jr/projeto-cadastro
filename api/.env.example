# Copie este arquivo para ".env" e ajuste com os dados do seu PostgreSQL local
DATABASE_USER=postgres
DATABASE_PASSWORD=sua_senha_aqui
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cadastros_db
PORT=5000

# Storage de anexos (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documentos

# Fila de mensagens (RabbitMQ). Vazio = fila desligada
RABBITMQ_URL=amqp://cadastrohub:cadastrohub123@localhost:5672

# Autenticação (veja o .env.example da raiz)
JWT_SECRET=troque-por-um-valor-aleatorio-longo
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
MFA_ADMIN=true

# E-mail (vazio = só mostra no log da API). Com o Mailpit: SMTP_HOST=localhost e SMTP_PORT=1025
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=CadastroHub <nao-responda@cadastrohub.local>
